DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Direct access to existing static files and directories (CSS, JS, images, _next)
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 2. Dynamic Product View Routing (/products/SLUG -> /products/view/index.html?id=SLUG)
  RewriteCond %{REQUEST_URI} !^/products/view/?$
  RewriteCond %{REQUEST_URI} ^/products/([^/]+)/?$
  RewriteRule ^products/([^/]+)/?$ /products/view/index.html?id=$1 [L,QSA]

  RewriteCond %{REQUEST_URI} !^/houseware/products/view/?$
  RewriteCond %{REQUEST_URI} ^/houseware/products/([^/]+)/?$
  RewriteRule ^houseware/products/([^/]+)/?$ /houseware/products/view/index.html?id=$1 [L,QSA]

  # 3. Folder Index & Clean Page Rewrites
  RewriteCond %{DOCUMENT_ROOT}/$1/index.html -f
  RewriteRule ^(.*)$ /$1/index.html [L,QSA]

  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^(.*)$ /$1.html [L,QSA]

  # 4. Fallback for unmatched routes
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ 404.html [L]
</IfModule>
