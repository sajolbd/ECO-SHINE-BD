<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Serve existing files and directories directly
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 2. Check if clean URL has a corresponding .html file on disk (e.g., /houseware -> /houseware.html)
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^(.*)$ $1.html [L]

  # 3. Dynamic Product Route Fallback for newly uploaded products from Dashboard
  # If a product page does not exist on disk, internally route to dynamic viewer
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^houseware/products/([^/]+)/?$ /houseware/products/view.html?id=$1 [QSA,L]

  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^products/([^/]+)/?$ /products/view.html?id=$1 [QSA,L]

  # 4. Custom 404 handler
  ErrorDocument 404 /404.html
</IfModule>
