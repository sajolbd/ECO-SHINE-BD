Options -MultiViews
RewriteEngine On
RewriteBase /

# 1. Dynamic Fallback for newly created products from Dashboard
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} ^/products/([^/]+)/?$
RewriteRule ^products/([^/]+)/?$ /products/view/index.html?id=$1 [L,QSA]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} ^/houseware/products/([^/]+)/?$
RewriteRule ^houseware/products/([^/]+)/?$ /houseware/products/view/index.html?id=$1 [L,QSA]

# 2. Handle direct file/directory requests
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# 3. Fallback to 404.html for all other unmatched routes
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^ 404.html [L]
